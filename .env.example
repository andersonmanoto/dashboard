# API
WEBHOOK_SECRET=webhook_secret
UPLOAD_API_KEY=upload_api_key
SCANNER_SECRET_TOKEN=scanner_secret_token
FUNNEL_SYNC_API_KEY=funnel_sync_api_key
JVZOO_SECRET_KEY=jvzoo_secret_key_de_api_and_3rd_party_applications
REDTRACK_OFFERS_API_KEY=redtrack_offers_api_key
SLICKTEXT_SETUP_ENDPOINT_KEY=slicktext_setup_endpoint_key

# Supabase
SUPABASE_URL=https://projeto.supabase.co
SUPABASE_KEY=supabase_key

# Slack
SLACK_BOT_TOKEN=xoxb-slack_bot_token

# SSH Scanner
SSH_HOST=ip_do_servidor
SSH_USERNAME=usuario
SSH_PASSWORD=senha
SSH_PORT=22

# RedTrack
REDTRACK_API_KEY=redtrack_api_key
REDTRACK_USER_ID=redtrack_user_id
# Envio de conversões (Purchase) pro RedTrack: só vendas com data >= esta (YYYY-MM-DD). Vazio = desligado.
REDTRACK_CONVERSIONS_SEND_FROM=
# products.id que NÃO enviam (separados por vírgula). Vazio = todos de internal_aff_ids.
REDTRACK_CONVERSIONS_EXCLUDED_PRODUCT_IDS=

# SlickText & AbstractAPI
ABSTRACT_API_KEY=abstract_api_key
SLICKTEXT_API_URL=https://api.slicktext.com/v1
# As api_keys das contas SlickText ficam no Vault do Supabase (cadastradas
# pelo front, ver migrations/20261027_slicktext_accounts_vault_status.sql).

# AutoPages (projeto Supabase separado)
AUTOPAGES_SUPABASE_URL=https://projeto-autopages.supabase.co
AUTOPAGES_SUPABASE_SERVICE_ROLE=autopages_supabase_service_role

# Zapier (leads: novos pedidos e carrinhos abandonados)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx/xxxxx/

# AWeber (leads da PagAmerican: vendas e carrinhos abandonados). Vazio = desligado.
# Tokens OAuth ficam na tabela aweber_oauth_tokens (carga: app/scripts/aweber_import_tokens.py).
AWEBER_CLIENT_ID=
AWEBER_CLIENT_SECRET=
AWEBER_ACCOUNT_ID=
AWEBER_DEFAULT_TAGS=pagamerican

# Redis: senha obrigatória (compose passa como --requirepass). Gerar com: openssl rand -hex 32
REDIS_PASSWORD=
