<!-- Motor: carrega VSL + links (não precisa editar) -->
<script>
  (function () {
    function mountVsl() {
      var tpl = document.getElementById("edit-vsl");
      var mount = document.getElementById("vsl-mount");
      if (!tpl || !mount) return;

      var content = tpl.content.cloneNode(true);
      content.querySelectorAll("script").forEach(function (oldScript) {
        var neu = document.createElement("script");
        Array.prototype.forEach.call(oldScript.attributes, function (attr) {
          neu.setAttribute(attr.name, attr.value);
        });
        neu.textContent = oldScript.textContent;
        oldScript.parentNode.replaceChild(neu, oldScript);
      });
      mount.innerHTML = "";
      mount.appendChild(content);
    }

    function applyCheckoutLinks() {
      var links = window.CHECKOUT_LINKS || {};
      var map = {
        "2b": links.bottles2,
        "3b": links.bottles3,
        "6b": links.bottles6,
      };

      Object.keys(map).forEach(function (key) {
        var url = map[key];
        if (!url) return;
        document
          .querySelectorAll(
            '[data-checkout="' + key + '"], #switchLink-' + key
          )
          .forEach(function (el) {
            el.setAttribute("href", url);
          });
      });
    }

    function boot() {
      mountVsl();
      applyCheckoutLinks();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  })();
</script>
[% endif %]

