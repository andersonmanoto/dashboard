# API
WEBHOOK_SECRET=webhook_secret
UPLOAD_API_KEY=upload_api_key
SCANNER_SECRET_TOKEN=scanner_secret_token
FUNNEL_SYNC_API_KEY=funnel_sync_api_key
REDTRACK_OFFERS_API_KEY=redtrack_offers_api_key

# Supabase
SUPABASE_URL=https://projeto.supabase.co
SUPABASE_KEY=supabase_key

# Slack
SLACK_BOT_TOKEN=xoxb-slack_bot_token

# SSH Scanner
SSH_HOST=ip_do_servidor
SSH_USERNAME=usuario
SSH_PASSWORD=senha
SSH_PORT=22

# RedTrack
REDTRACK_API_KEY=redtrack_api_key
REDTRACK_USER_ID=redtrack_user_id

# SlickText & AbstractAPI
ABSTRACT_API_KEY=abstract_api_key
SLICKTEXT_API_URL=https://api.slicktext.com/v1
# Conta 'default' (slicktext_accounts.name = 'default')
SLICKTEXT_API_KEY=slicktext_api_key
SLICKTEXT_BRAND_ID=slicktext_brand_id
# Cada conta SlickText adicional cadastrada em slicktext_accounts precisa de
# uma api_key própria aqui, seguindo o padrão SLICKTEXT_API_KEY_<NOME em
# maiúsculo, sem espaços> (brand_id dessas contas fica no banco, não é segredo):
# SLICKTEXT_API_KEY_VELUPET=slicktext_api_key_velupet

# AutoPages (projeto Supabase separado)
AUTOPAGES_SUPABASE_URL=https://projeto-autopages.supabase.co
AUTOPAGES_SUPABASE_SERVICE_ROLE=autopages_supabase_service_role