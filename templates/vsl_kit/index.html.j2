{{ pv.redtrackScript | safe }}
{% endfor %}
{% endif %}
<!-- END -->
[% else %]
  <script>
    document.addEventListener("DOMContentLoaded", initDelayForHiddenElements);
    function initDelayForHiddenElements() {
      const delaySeconds = Number(window.VSL_PITCH_SECONDS) || 0;
      const player = document.querySelector("vturb-smartplayer");
      if (!player) return;
      player.addEventListener("player:ready", () => {
        showElementsAfterDelay(player, delaySeconds);
      });
    }
    function showElementsAfterDelay(player, seconds) {
      player.displayHiddenElements(seconds, [".esconder"], {
        persist: true
      });
    }
  </script>
[% endif %]
