  <script defer>
    (function () {
      var days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      var now = new Date();
      var el = document.querySelector(".hoje");
      if (el) {
        el.textContent = days[now.getDay()] + ", " + now.getDate() + " " + months[now.getMonth()] + " " + now.getFullYear();
      }
    })();
  </script>
  <script defer>
    function formatCountdown(ms) {
      var totalSeconds = Math.max(0, Math.floor(ms / 1000));
      var mins = Math.floor(totalSeconds / 60);
      var secs = totalSeconds % 60;
      return (mins < 10 ? "0" + mins : String(mins)) + ":" + (secs < 10 ? "0" + secs : String(secs));
    }
    (function () {
      try {
        document.querySelectorAll(".atomicat-countdown-text").forEach(function (el) {
          var dataTime = el.getAttribute("data-time");
          if (!dataTime || !el.id) {
            return;
          }
          var parts = dataTime.split(":").map(Number);
          var totalMs = ((parts[0] || 0) * 60 + (parts[1] || 0)) * 1000;
          var storageKey = "pv_countdown_start_" + el.id;
          var start = sessionStorage.getItem(storageKey);
          if (!start) {
            start = String(Date.now());
            sessionStorage.setItem(storageKey, start);
          }
          function tick() {
            var elapsed = Date.now() - parseInt(start, 10);
            var remaining = totalMs - elapsed;
            if (remaining <= 0) {
              el.textContent = "00:00";
              return;
            }
            el.textContent = formatCountdown(remaining);
          }
          tick();
          setInterval(tick, 1000);
        });
      } catch (err) {
        console.log(err);
      }
    })();
  </script>
  <script defer>
    (function () {
      try {
        var countEl = document.getElementById("pv-watching-count");
        if (!countEl) {
          return;
        }
        var base = 790;
        var offset = Math.floor(Math.random() * 41) - 20;
        var current = base + offset;
        function render() {
          countEl.textContent = current.toLocaleString("en-US");
        }
        render();
        setInterval(function () {
          current += Math.floor(Math.random() * 7) - 3;
          if (current < base - 120) {
            current = base - 120;
          }
          if (current > base + 180) {
            current = base + 180;
          }
          render();
        }, 4000);
      } catch (err) {
        console.log(err);
      }
    })();
  </script>
